# Steam Web API Key
# Get your API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Your Steam ID (17-digit numeric ID)
# Find your Steam ID at: https://steamid.io/
STEAM_ID=your_steam_id_here

# Steam account credentials for Mode 4 with private Chat Groups (optional)
# Required only when fetching members from private Steam Chat groups via invite link.
# If Steam Guard is enabled, you will be prompted for the code at runtime.
# These values are never logged.
STEAM_USERNAME=your_steam_username_here
STEAM_PASSWORD=your_steam_password_here
