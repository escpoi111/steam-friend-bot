# Steam Web API 密钥
# 获取地址: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# 你的 SteamID64 (17位数字)
# 查询地址: https://steamid.io/
STEAM_ID=your_steam_id_here

# Steam 登录后的 sessionid (从浏览器 Cookie 中获取)
STEAM_SESSION_ID=your_session_id_here

# Steam 登录后的 cookies 字符串 (从浏览器中获取)
# 格式: steamLoginSecure=xxxx; sessionid=xxxx
STEAM_COOKIES=your_cookies_here

# 每次添加好友之间的延迟秒数 (默认5秒，避免触发Steam限制)
ADD_DELAY_SECONDS=5

# 好友代码文件路径 (默认 friend_codes.txt)
FRIEND_CODES_FILE=friend_codes.txt

# 排除列表文件路径 (默认 exclude_list.txt)
EXCLUDE_FILE=exclude_list.txt
